{
  "manifest_version": 3,
  "name": "BiliMemo",
  "version": "0.1.16",
  "minimum_chrome_version": "116",
  "description": "B站与 YouTube 视频学习助手：原始字幕阅读、播放同步、按需翻译、章节概览与时间戳摘录。",
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://api.supadata.ai/*",
    "https://api.deepseek.com/*",
    "https://www.bilibili.com/*",
    "https://api.bilibili.com/*",
    "https://aisubtitle.hdslb.com/*",
    "https://i0.hdslb.com/*",
    "https://i1.hdslb.com/*",
    "https://i2.hdslb.com/*",
    "https://subtitle.bilibili.com/*"
  ],
  "action": {
    "default_title": "打开 BiliMemo",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.bilibili.com/*"
      ],
      "js": [
        "platforms.js",
        "bilibili-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ]
}
